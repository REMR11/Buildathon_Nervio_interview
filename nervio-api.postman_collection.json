                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "interview",
                "{{sessionId}}",
                "messages"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"candidate\",\n  \"text\": \"Lideré el frontend de un panel de métricas en Next.js.\"\n}"
            },
            "description": "Persiste un turno (interviewer = pregunta, candidate = respuesta)."
          }
        },
        {
          "name": "Get session",
          "request": {
            "method": "GET",
            "header": [],
