                "sign-in",
                "email"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@nervio.dev\",\n  \"password\": \"Nervio#2026\"\n}"
            },
            "description": "Inicia sesión. La cookie HttpOnly resultante queda en el cookie jar de Postman y autentica el resto de peticiones."
