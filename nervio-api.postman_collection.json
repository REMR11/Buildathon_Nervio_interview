                "auth",
                "sign-up",
                "email"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Candidata Demo\",\n  \"email\": \"demo@nervio.dev\",\n  \"password\": \"Nervio#2026\"\n}"
            },
            "description": "Registra un candidato. Better Auth crea user + account (hash scrypt) y, con autoSignIn, emite la cookie de sesión."
          }
        },
        {
          "name": "Sign In (email/password)",
          "request": {
            "method": "POST",
            "header": [
              {
