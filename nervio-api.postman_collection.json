                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "interview",
                "{{sessionId}}",
                "end"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"conversationId\": null,\n  \"reason\": \"manual\",\n  \"skipEvaluation\": true\n}"
