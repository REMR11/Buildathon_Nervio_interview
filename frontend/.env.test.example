# Entorno de pruebas. Copia a `.env.test` si quieres sobreescribir valores locales.
# No contiene secretos reales. Nunca apuntes esto a una base de producción.

# PostgreSQL de prueba (local / GitHub Actions service)
POSTGRES_URL="postgresql://nervio:nervio@127.0.0.1:5432/nervio_test"
DATABASE_URL="postgresql://nervio:nervio@127.0.0.1:5432/nervio_test"
DIRECT_URL="postgresql://nervio:nervio@127.0.0.1:5432/nervio_test"

# Better Auth (valor ficticio, ≥ 32 caracteres)
BETTER_AUTH_SECRET="test-secret-at-least-32-characters-long"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cron de prueba
CRON_SECRET="test-cron-secret"

# Servicios externos: dejar vacíos. Las pruebas los mockean y bloquean fetch.
ELEVENLABS_API_KEY=""
ELEVENLABS_AGENT_ID=""
ELEVENLABS_VOICE_ID=""
N8N_WEBHOOK_GENERATE_INTERVIEW_URL=""
N8N_WEBHOOK_SCHEDULE_NOTIFICATION_URL=""
