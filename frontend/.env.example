# PostgreSQL (Supabase) — Settings → Database → Connection string
# Runtime (Transaction pooler, puerto 6543). Usuario: postgres.[PROJECT_REF]
POSTGRES_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
# Opcional: si no defines POSTGRES_URL, la app usa DATABASE_URL (cuidado con JDBC en el sistema)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
# Migraciones Prisma (Direct connection, puerto 5432). Usuario: postgres
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require"

# Better Auth
BETTER_AUTH_SECRET="generar-con-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

# ElevenLabs Conversational AI (solo servidor — no usar NEXT_PUBLIC_)
ELEVENLABS_API_KEY="tu-api-key"
ELEVENLABS_AGENT_ID="tu-agent-id"
ELEVENLABS_VOICE_ID="tu-voice-id"

# N8N opcional: si faltan o fallan, Next.js usa Prisma/local fallback
N8N_WEBHOOK_GENERATE_INTERVIEW_URL=""
N8N_WEBHOOK_SCHEDULE_NOTIFICATION_URL=""

# URL pública de la app (enlaces en correos de citas)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Resend — confirmación al agendar y recordatorio según el margen
RESEND_API_KEY=""
EMAIL_FROM="Nervio <onboarding@resend.dev>"

# Cron de Vercel: Authorization Bearer de /api/cron/reminders
CRON_SECRET=""

# Mock local sin agente ElevenLabs (opcional)
# NEXT_PUBLIC_USE_MOCK_INTERVIEW="true"

# Supabase Storage (grabaciones). La service role key es SOLO servidor.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_RECORDINGS_BUCKET="interview-recordings"
# Bucket privado para CVs (se crea automáticamente si no existe)
SUPABASE_CVS_BUCKET="cvs"
